FROM temporalio/server:1.32.1@sha256:acecbab5b0b8ae9cf4012b508866ca97feda3709577bf157b537239f40029049 AS server
FROM temporalio/admin-tools:1.32.1@sha256:9ef0dc5b063bf4ffd5c1512de72e0e73e225bd2c7006a18ce69bd592a8862a83 AS tools
# This pinned base supplies psql for session advisory locks; it does not run a second DB.
FROM postgres:18.6-trixie@sha256:74935e72241653ca55e0414067e6d8763aceb8a810eb51b452253ec3dcfc4336
COPY --from=server /usr/local/bin/temporal-server /usr/local/bin/temporal-server
COPY --from=tools /usr/local/bin/temporal-sql-tool /usr/local/bin/temporal-sql-tool
COPY --from=tools /usr/local/bin/temporal /usr/local/bin/temporal
COPY --from=tools /etc/temporal/schema /etc/temporal/schema
COPY deploy/temporal-dynamic.yaml /etc/temporal/config/dynamicconfig/docker.yaml
COPY --chmod=755 deploy/temporal-entrypoint.sh deploy/temporal-migrate.sh /opt/specmate/
USER postgres
WORKDIR /etc/temporal
ENTRYPOINT ["/opt/specmate/temporal-entrypoint.sh"]
CMD []
