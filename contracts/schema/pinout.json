{
  "$defs": {
    "Assignment": {
      "additionalProperties": false,
      "properties": {
        "alternatives": {
          "items": {
            "$ref": "#/$defs/ConditionalSignal"
          },
          "maxItems": 20,
          "title": "Alternatives",
          "type": "array"
        },
        "contact_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Contact Id",
          "type": "string"
        },
        "electrical": {
          "$ref": "#/$defs/ElectricalContract"
        }
      },
      "required": [
        "contact_id"
      ],
      "title": "Assignment",
      "type": "object"
    },
    "ConditionChoice": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,79}$",
          "title": "Key",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "key",
        "name"
      ],
      "title": "ConditionChoice",
      "type": "object"
    },
    "ConditionalRating": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Basis",
          "type": "string"
        },
        "dimension": {
          "enum": [
            "voltage",
            "current"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/EvidenceInput"
        },
        "local_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,79}$",
          "title": "Local Id",
          "type": "string"
        },
        "maximum": {
          "title": "Maximum",
          "type": "number"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "scope": {
          "$ref": "#/$defs/RatingScope"
        }
      },
      "required": [
        "local_id",
        "dimension",
        "maximum",
        "scope",
        "basis"
      ],
      "title": "ConditionalRating",
      "type": "object"
    },
    "ConditionalSignal": {
      "additionalProperties": false,
      "description": "What one pin carries when a named condition takes one choice.",
      "properties": {
        "basis": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Basis",
          "type": "string"
        },
        "choice": {
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,79}$",
          "title": "Choice",
          "type": "string"
        },
        "condition_key": {
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,79}$",
          "title": "Condition Key",
          "type": "string"
        },
        "role": {
          "default": "unknown",
          "enum": [
            "signal",
            "power",
            "return",
            "shield",
            "chassis",
            "unused",
            "unknown"
          ],
          "title": "Role",
          "type": "string"
        },
        "signal": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signal"
        },
        "signal_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/SignalRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "condition_key",
        "choice",
        "basis"
      ],
      "title": "ConditionalSignal",
      "type": "object"
    },
    "ElectricalContract": {
      "additionalProperties": false,
      "description": "Declared limits and roles, never measured compatibility or conductor identity.",
      "properties": {
        "basis": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Basis"
        },
        "condition": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition"
        },
        "conditional_ratings": {
          "items": {
            "$ref": "#/$defs/ConditionalRating"
          },
          "maxItems": 100,
          "title": "Conditional Ratings",
          "type": "array"
        },
        "current_max_a": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Max A"
        },
        "direction": {
          "default": "unknown",
          "enum": [
            "input",
            "output",
            "bidirectional",
            "passive",
            "unknown"
          ],
          "title": "Direction",
          "type": "string"
        },
        "polarity": {
          "default": "unknown",
          "enum": [
            "unknown",
            "positive",
            "negative",
            "reference",
            "nonpolarized"
          ],
          "title": "Polarity",
          "type": "string"
        },
        "polarity_basis": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Polarity Basis"
        },
        "protocol": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Protocol"
        },
        "role": {
          "default": "unknown",
          "enum": [
            "signal",
            "power",
            "return",
            "shield",
            "chassis",
            "unused",
            "unknown"
          ],
          "title": "Role",
          "type": "string"
        },
        "signal": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signal"
        },
        "signal_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/SignalRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "voltage_max_v": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Voltage Max V"
        },
        "voltage_min_v": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Voltage Min V"
        }
      },
      "title": "ElectricalContract",
      "type": "object"
    },
    "EvidenceInput": {
      "additionalProperties": false,
      "properties": {
        "citation": {
          "anyOf": [
            {
              "maxLength": 4000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Citation"
        },
        "source_bundle_revision_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Bundle Revision Id"
        },
        "source_path": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Path"
        },
        "status": {
          "default": "unknown",
          "enum": [
            "unknown",
            "unverified_citation",
            "registered_file"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "title": "EvidenceInput",
      "type": "object"
    },
    "Orientation": {
      "additionalProperties": false,
      "properties": {
        "datum": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Datum"
        },
        "rotation_degrees": {
          "anyOf": [
            {
              "exclusiveMaximum": 360,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rotation Degrees"
        },
        "viewing_side": {
          "default": "unknown",
          "enum": [
            "mating",
            "termination",
            "unknown"
          ],
          "title": "Viewing Side",
          "type": "string"
        }
      },
      "title": "Orientation",
      "type": "object"
    },
    "PinoutCondition": {
      "additionalProperties": false,
      "description": "A named device condition (for example a regional variant) that selects pin meanings.",
      "properties": {
        "choices": {
          "items": {
            "$ref": "#/$defs/ConditionChoice"
          },
          "maxItems": 20,
          "minItems": 2,
          "title": "Choices",
          "type": "array"
        },
        "key": {
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,79}$",
          "title": "Key",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "key",
        "name",
        "choices"
      ],
      "title": "PinoutCondition",
      "type": "object"
    },
    "RatingScope": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mode"
        },
        "temperature": {
          "anyOf": [
            {
              "$ref": "#/$defs/TemperatureEnvelope"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "RatingScope",
      "type": "object"
    },
    "SignalRef": {
      "additionalProperties": false,
      "description": "Exact signal identity: one frozen signal set revision and a key inside it.",
      "properties": {
        "key": {
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,79}$",
          "title": "Key",
          "type": "string"
        },
        "signal_set_revision_id": {
          "format": "uuid",
          "title": "Signal Set Revision Id",
          "type": "string"
        }
      },
      "required": [
        "signal_set_revision_id",
        "key"
      ],
      "title": "SignalRef",
      "type": "object"
    },
    "TemperatureEnvelope": {
      "additionalProperties": false,
      "properties": {
        "maximum_c": {
          "title": "Maximum C",
          "type": "number"
        },
        "minimum_c": {
          "title": "Minimum C",
          "type": "number"
        }
      },
      "required": [
        "minimum_c",
        "maximum_c"
      ],
      "title": "TemperatureEnvelope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assignments": {
      "items": {
        "$ref": "#/$defs/Assignment"
      },
      "maxItems": 1000,
      "title": "Assignments",
      "type": "array"
    },
    "body_revision_id": {
      "format": "uuid",
      "title": "Body Revision Id",
      "type": "string"
    },
    "conditions": {
      "items": {
        "$ref": "#/$defs/PinoutCondition"
      },
      "maxItems": 20,
      "title": "Conditions",
      "type": "array"
    },
    "kind": {
      "const": "pinout",
      "default": "pinout",
      "title": "Kind",
      "type": "string"
    },
    "orientation": {
      "$ref": "#/$defs/Orientation"
    },
    "review": {
      "default": "unreviewed",
      "enum": [
        "unreviewed",
        "reviewed"
      ],
      "title": "Review",
      "type": "string"
    },
    "review_basis": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review Basis"
    },
    "role": {
      "default": "unknown",
      "enum": [
        "source",
        "sink",
        "bidirectional",
        "unknown"
      ],
      "title": "Role",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "standard": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Standard"
    },
    "variant_label": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Variant Label"
    }
  },
  "required": [
    "body_revision_id"
  ],
  "title": "Pinout",
  "type": "object"
}
