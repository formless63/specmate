        "basis": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Basis"
        },
        "differential_with": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9_.-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Differential With"
        },
        "impedance": {
          "$ref": "#/$defs/SignalImpedance"
        },
        "key": {
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,79}$",
          "title": "Key",
          "type": "string"
        },
        "level": {
          "$ref": "#/$defs/SignalLevel"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "return_for": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9_.-]{0,79}$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Return For",
          "type": "array"
        },
        "type": {
          "default": "unknown",
          "enum": [
            "analog_video",
            "sync",
            "analog_audio",
            "digital_audio",
            "power",
            "ground_return",
            "shield",
            "chassis",
            "data",
            "control",
            "other",
            "unknown"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "key",
        "name"
      ],
      "title": "Signal",
      "type": "object"
    },
