{
  "$defs": {
    "SourceBundleFileEntry": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "rights": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Rights",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes",
        "media_type",
        "rights"
      ],
      "title": "SourceBundleFileEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "ancestry": {
      "items": {
        "type": "string"
      },
      "title": "Ancestry",
      "type": "array"
    },
    "bundle_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Bundle Id",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/SourceBundleFileEntry"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Files",
      "type": "array"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_revision": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Source Revision",
      "type": "string"
    },
    "synthetic": {
      "default": false,
      "title": "Synthetic",
      "type": "boolean"
    }
  },
  "required": [
    "bundle_id",
    "source_revision",
    "files"
  ],
  "title": "SourceBundleManifest",
  "type": "object"
}
