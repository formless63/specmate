{
  "$defs": {
    "ModelMetadata": {
      "additionalProperties": false,
      "description": "Declared representation frame, never an inferred size or qualification.",
      "properties": {
        "basis": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Basis",
          "type": "string"
        },
        "builder_version": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Builder Version"
        },
        "frame": {
          "anyOf": [
            {
              "enum": [
                "right_handed_y_up",
                "right_handed_z_up"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Frame"
        },
        "purpose": {
          "enum": [
            "illustration",
            "clearance",
            "manufacturing"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "units": {
          "anyOf": [
            {
              "enum": [
                "mm",
                "m",
                "in"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Units"
        }
      },
      "required": [
        "units",
        "frame",
        "purpose",
        "basis"
      ],
      "title": "ModelMetadata",
      "type": "object"
    }
  },
  "properties": {
    "definition_id": {
      "format": "uuid",
      "title": "Definition Id",
      "type": "string"
    },
    "definition_kind": {
      "title": "Definition Kind",
      "type": "string"
    },
    "definition_name": {
      "title": "Definition Name",
      "type": "string"
    },
    "kind": {
      "enum": [
        "symbol",
        "footprint",
        "model",
        "drawing",
        "datasheet"
      ],
      "title": "Kind",
      "type": "string"
    },
    "label": {
      "title": "Label",
      "type": "string"
    },
    "media_type": {
      "title": "Media Type",
      "type": "string"
    },
    "model_metadata": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModelMetadata"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "representation_id": {
      "format": "uuid",
      "title": "Representation Id",
      "type": "string"
    },
    "revision_id": {
      "format": "uuid",
      "title": "Revision Id",
      "type": "string"
    },
    "revision_number": {
      "title": "Revision Number",
      "type": "integer"
    },
    "rights": {
      "title": "Rights",
      "type": "string"
    },
    "rights_status": {
      "enum": [
        "cleared",
        "restricted",
        "unknown"
      ],
      "title": "Rights Status",
      "type": "string"
    },
    "sha256": {
      "title": "Sha256",
      "type": "string"
    },
    "source_bundle_revision_id": {
      "format": "uuid",
      "title": "Source Bundle Revision Id",
      "type": "string"
    },
    "source_path": {
      "title": "Source Path",
      "type": "string"
    }
  },
  "required": [
    "representation_id",
    "revision_id",
    "revision_number",
    "definition_id",
    "definition_name",
    "definition_kind",
    "kind",
    "label",
    "source_bundle_revision_id",
    "source_path",
    "sha256",
    "media_type",
    "rights",
    "rights_status"
  ],
  "title": "RepresentationResult",
  "type": "object"
}
