{
  "$defs": {
    "Quantity": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ],
          "description": "Use exact decimal strings or integers; floating-point amounts are rejected.",
          "title": "Amount"
        },
        "unit": {
          "enum": [
            "ea",
            "m",
            "cm",
            "mm",
            "kg",
            "g"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "unit"
      ],
      "title": "Quantity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assertion_source": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Assertion Source",
      "type": "string"
    },
    "assertion_status": {
      "default": "declared",
      "enum": [
        "declared",
        "observed",
        "measured"
      ],
      "title": "Assertion Status",
      "type": "string"
    },
    "expected_work_state": {
      "format": "uuid",
      "title": "Expected Work State",
      "type": "string"
    },
    "physical_unit_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Physical Unit Id"
    },
    "quantity": {
      "$ref": "#/$defs/Quantity"
    },
    "reason": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "remainder": {
      "enum": [
        "retain",
        "release"
      ],
      "title": "Remainder",
      "type": "string"
    },
    "reservation_id": {
      "format": "uuid",
      "title": "Reservation Id",
      "type": "string"
    },
    "work_batch_id": {
      "format": "uuid",
      "title": "Work Batch Id",
      "type": "string"
    }
  },
  "required": [
    "reason",
    "assertion_source",
    "reservation_id",
    "work_batch_id",
    "quantity",
    "remainder",
    "expected_work_state"
  ],
  "title": "Consume",
  "type": "object"
}
