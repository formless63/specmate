  "additionalProperties": false,
  "properties": {
    "construction": {
      "enum": [
        "coax",
        "pair",
        "ribbon",
        "figure-eight",
        "bundle"
      ],
      "title": "Construction",
      "type": "string"
    },
    "facts": {
      "additionalProperties": {
        "$ref": "#/$defs/Fact"
      },
      "maxProperties": 50,
      "title": "Facts",
      "type": "object"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "structure": {
