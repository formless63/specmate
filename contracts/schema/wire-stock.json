          "default": null,
          "title": "Outer Diameter Mm"
        },
        "source": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "x_mm": {
          "default": 0,
          "title": "X Mm",
          "type": "number"
        },
        "y_mm": {
          "default": 0,
          "title": "Y Mm",
          "type": "number"
        }
      },
      "required": [
        "id",
        "label",
        "kind"
      ],
      "title": "RoundElement",
      "type": "object"
    },
    "WebElement": {
