{
  "$defs": {
    "Fact": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "status": {
          "default": "unknown",
          "enum": [
            "unknown",
            "documented",
            "measured",
            "inferred"
          ],
          "title": "Status",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "title": "Fact",
      "type": "object"
    },
    "GroupElement": {
      "additionalProperties": false,
      "properties": {
        "arrangement": {
          "default": "concentric",
          "enum": [
            "concentric",
            "ring",
            "linear",
            "figure-eight"
          ],
          "title": "Arrangement",
          "type": "string"
        },
        "children": {
          "items": {
            "discriminator": {
              "mapping": {
                "conductor": "#/$defs/RoundElement",
                "dielectric": "#/$defs/RoundElement",
                "drain": "#/$defs/RoundElement",
                "filler": "#/$defs/RoundElement",
                "group": "#/$defs/GroupElement",
                "insulation": "#/$defs/RoundElement",
                "jacket": "#/$defs/RoundElement",
                "shield": "#/$defs/RoundElement",
                "web": "#/$defs/WebElement"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/RoundElement"
              },
              {
                "$ref": "#/$defs/WebElement"
              },
              {
                "$ref": "#/$defs/GroupElement"
              }
            ]
          },
          "maxItems": 128,
          "title": "Children",
          "type": "array"
        },
        "color": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        },
        "direction": {
          "default": "ccw",
          "enum": [
            "cw",
            "ccw"
          ],
          "title": "Direction",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "group",
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "material": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Material"
        },
        "pitch_mm": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pitch Mm"
        },
        "role": {
          "enum": [
            "stock",
            "coax",
            "pair",
            "ribbon",
            "figure-eight",
            "bundle"
          ],
          "title": "Role",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "x_mm": {
          "default": 0,
          "title": "X Mm",
          "type": "number"
        },
        "y_mm": {
          "default": 0,
          "title": "Y Mm",
          "type": "number"
        }
      },
      "required": [
        "id",
        "label",
        "kind",
        "role"
      ],
      "title": "GroupElement",
      "type": "object"
    },
    "RoundElement": {
