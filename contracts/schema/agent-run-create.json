        "type": "string"
      },
      "maxItems": 20,
      "title": "Boundary Actions",
      "type": "array"
    },
    "checkpoint_every": {
      "anyOf": [
        {
          "maximum": 1000,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Checkpoint Every"
    },
    "deadline": {
      "format": "date-time",
      "title": "Deadline",
      "type": "string"
