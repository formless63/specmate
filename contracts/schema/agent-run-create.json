{
  "additionalProperties": false,
  "description": "Grant an agent account a bounded, draft-level scope on the sponsor's behalf.",
  "properties": {
    "agent_username": {
      "anyOf": [
        {
          "maxLength": 150,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agent Username"
    },
    "allowed_actions": {
      "items": {
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
