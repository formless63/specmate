      "minimum": 1,
      "title": "Max Actions",
      "type": "integer"
    },
    "project_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Id"
    },
    "purpose": {
      "default": "",
      "maxLength": 4000,
      "title": "Purpose",
      "type": "string"
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "workspace_id": {
      "format": "uuid",
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "title",
    "allowed_actions",
    "max_actions",
    "deadline"
