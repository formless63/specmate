{
  "$defs": {
    "LibraryField": {
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "key",
        "label"
      ],
      "title": "LibraryField",
      "type": "object"
    },
    "LibraryNumber": {
      "properties": {
        "basis": {
          "const": "manufacturer_variant",
          "default": "manufacturer_variant",
          "title": "Basis",
          "type": "string"
        },
        "manufacturer": {
          "title": "Manufacturer",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "manufacturer",
        "value"
      ],
      "title": "LibraryNumber",
      "type": "object"
    },
    "LibrarySummary": {
      "properties": {
        "basis": {
          "enum": [
            "latest_frozen",
            "newest_draft",
            "unknown"
          ],
          "title": "Basis",
          "type": "string"
        },
        "draft_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Draft Id"
        },
        "draft_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Draft Version"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/LibraryField"
          },
          "title": "Fields",
          "type": "array"
        },
        "flags": {
          "items": {
            "type": "string"
          },
          "title": "Flags",
          "type": "array"
        },
        "numbers": {
          "items": {
            "$ref": "#/$defs/LibraryNumber"
          },
          "maxItems": 20,
          "title": "Numbers",
          "type": "array"
        },
        "numbers_truncated": {
          "default": false,
          "title": "Numbers Truncated",
          "type": "boolean"
        },
        "revision_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision Id"
        }
      },
      "required": [
        "basis"
      ],
      "title": "LibrarySummary",
      "type": "object"
    },
    "LibraryTableRecord": {
      "properties": {
        "changed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Latest draft change, when the family has drafts.",
          "title": "Changed At"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "family": {
          "enum": [
            "definition",
            "source_bundle",
            "physical_unit",
            "stock_account",
            "fact_subject"
          ],
          "title": "Family",
          "type": "string"
        },
        "kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Definition kind, source role, unit origin, \u2026",
          "title": "Kind"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "latest_revision": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Highest frozen revision number; null when none is frozen.",
          "title": "Latest Revision"
        },
        "latest_revision_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The latest frozen design revision, for an exact pin.",
          "title": "Latest Revision Id"
        },
        "record_id": {
          "format": "uuid",
          "title": "Record Id",
          "type": "string"
        },
        "referenceable": {
          "description": "Whether a project can reference this record.",
          "title": "Referenceable",
          "type": "boolean"
        },
        "referenced": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Referenced by the context project; null without a project context.",
          "title": "Referenced"
        },
        "summary": {
          "$ref": "#/$defs/LibrarySummary"
        },
        "used_in": {
          "description": "Active project references, bounded.",
          "items": {
            "$ref": "#/$defs/UsedIn"
          },
          "title": "Used In",
          "type": "array"
        },
        "used_in_total": {
          "minimum": 0,
          "title": "Used In Total",
          "type": "integer"
        }
      },
      "required": [
        "record_id",
        "family",
        "kind",
        "label",
        "created_at",
        "referenceable",
        "referenced",
        "used_in",
        "used_in_total",
        "summary"
      ],
      "title": "LibraryTableRecord",
      "type": "object"
    },
    "UsedIn": {
      "properties": {
        "archived": {
          "title": "Archived",
          "type": "boolean"
        },
        "pin": {
          "enum": [
            "floating",
            "exact"
          ],
          "title": "Pin",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "project_name": {
          "title": "Project Name",
          "type": "string"
        },
        "reference_id": {
          "format": "uuid",
          "title": "Reference Id",
          "type": "string"
        },
        "revision": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Pinned revision number for an exact reference.",
          "title": "Revision"
        },
        "role": {
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "reference_id",
        "project_id",
        "project_name",
        "archived",
        "pin",
        "revision",
        "role"
      ],
      "title": "UsedIn",
      "type": "object"
    }
  },
  "properties": {
    "family": {
      "enum": [
        "definition",
        "source_bundle",
        "physical_unit",
        "stock_account",
        "fact_subject"
      ],
      "title": "Family",
      "type": "string"
    },
    "next_after": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Opaque cursor; null on the last page.",
      "title": "Next After"
    },
    "project_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Project Id"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/LibraryTableRecord"
      },
      "title": "Results",
      "type": "array"
    },
    "workspace_id": {
      "format": "uuid",
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "family",
    "project_id",
    "results",
    "next_after"
  ],
  "title": "LibraryTablePage",
  "type": "object"
}
