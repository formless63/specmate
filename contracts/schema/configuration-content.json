{
  "$defs": {
    "Selection": {
      "additionalProperties": false,
      "description": "`choice_key: null` deliberately leaves an optional option without a choice.",
      "properties": {
        "choice_key": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Choice Key"
        },
        "option_key": {
          "pattern": "^[a-z][a-z0-9_-]{0,79}$",
          "title": "Option Key",
          "type": "string"
        }
      },
      "required": [
        "option_key",
        "choice_key"
      ],
      "title": "Selection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "option_set_revision_id": {
      "format": "uuid",
      "title": "Option Set Revision Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "selections": {
      "items": {
        "$ref": "#/$defs/Selection"
      },
      "maxItems": 200,
      "title": "Selections",
      "type": "array"
    }
  },
  "required": [
    "option_set_revision_id"
  ],
  "title": "ConfigurationContent",
  "type": "object"
}
