{
  "$defs": {
    "KitLine": {
      "additionalProperties": false,
      "properties": {
        "local_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,79}$",
          "title": "Local Id",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "quantity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "revision_id": {
          "format": "uuid",
          "title": "Revision Id",
          "type": "string"
        }
      },
      "required": [
        "local_id",
        "revision_id"
      ],
      "title": "KitLine",
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ],
          "description": "Use exact decimal strings or integers; floating-point amounts are rejected.",
          "title": "Amount"
        },
        "unit": {
          "enum": [
            "ea",
            "m",
            "cm",
            "mm",
            "kg",
            "g"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "unit"
      ],
      "title": "Quantity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "lines": {
      "items": {
        "$ref": "#/$defs/KitLine"
      },
      "maxItems": 256,
      "title": "Lines",
      "type": "array"
    },
    "schema_version": {
      "const": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "semantics": {
      "const": "catalog_grouping",
      "default": "catalog_grouping",
      "title": "Semantics",
      "type": "string"
    }
  },
  "required": [
    "schema_version"
  ],
  "title": "Kit",
  "type": "object"
}
