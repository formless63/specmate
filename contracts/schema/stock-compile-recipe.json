    "StockRecipe": {
      "additionalProperties": false,
      "properties": {
        "bindings": {
          "items": {
            "$ref": "#/$defs/Binding"
          },
          "maxItems": 1024,
          "title": "Bindings",
          "type": "array"
        },
        "constituents": {
          "items": {
            "$ref": "#/$defs/ConstituentPin"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Constituents",
          "type": "array"
        },
        "recompute_boundaries": {
          "default": false,
          "title": "Recompute Boundaries",
          "type": "boolean"
        },
        "recompute_layout": {
          "default": "preserve",
          "enum": [
            "preserve",
            "touching_ring"
          ],
          "title": "Recompute Layout",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "template": {
          "$ref": "#/$defs/StockSpecification"
        }
      },
      "required": [
        "template",
        "constituents",
        "source"
      ],
      "title": "StockRecipe",
      "type": "object"
