{
  "$defs": {
    "Binding": {
      "additionalProperties": false,
      "properties": {
        "element_path": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Element Path",
          "type": "string"
        },
        "formula": {
          "default": "identity",
          "enum": [
            "identity",
            "conductor_area",
            "stranded_diameter",
            "over_layer_diameter",
            "adjacent_boundary",
            "insulation_diameter",
            "shield_diameter",
            "insulation_material"
          ],
          "title": "Formula",
          "type": "string"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/Input"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Inputs",
          "type": "array"
        },
        "round_digits": {
          "anyOf": [
            {
              "maximum": 6,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Round Digits"
        },
        "target_field": {
          "title": "Target Field",
          "type": "string"
        }
      },
      "required": [
        "element_path",
        "target_field",
        "inputs"
      ],
      "title": "Binding",
      "type": "object"
    },
    "ConstituentPin": {
      "additionalProperties": false,
      "properties": {
        "local_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Local Id",
          "type": "string"
        },
        "revision_id": {
          "format": "uuid",
          "title": "Revision Id",
          "type": "string"
        },
        "snapshot_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Snapshot Sha256",
          "type": "string"
        }
      },
      "required": [
        "local_id",
        "revision_id",
        "snapshot_sha256"
      ],
      "title": "ConstituentPin",
      "type": "object"
    },
    "Fact": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "status": {
          "default": "unknown",
          "enum": [
            "unknown",
            "documented",
            "measured",
            "inferred"
          ],
          "title": "Status",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "title": "Fact",
      "type": "object"
    },
    "GroupElement": {
      "additionalProperties": false,
      "properties": {
        "arrangement": {
          "default": "concentric",
          "enum": [
            "concentric",
            "ring",
            "linear",
            "figure-eight"
          ],
          "title": "Arrangement",
          "type": "string"
        },
        "children": {
          "items": {
            "discriminator": {
              "mapping": {
                "conductor": "#/$defs/RoundElement",
                "dielectric": "#/$defs/RoundElement",
                "drain": "#/$defs/RoundElement",
                "filler": "#/$defs/RoundElement",
                "group": "#/$defs/GroupElement",
                "insulation": "#/$defs/RoundElement",
                "jacket": "#/$defs/RoundElement",
                "shield": "#/$defs/RoundElement",
                "web": "#/$defs/WebElement"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/RoundElement"
              },
              {
                "$ref": "#/$defs/WebElement"
              },
              {
                "$ref": "#/$defs/GroupElement"
              }
            ]
          },
          "maxItems": 128,
          "title": "Children",
          "type": "array"
        },
        "color": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        },
        "color_label": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color Label"
        },
        "direction": {
          "default": "ccw",
          "enum": [
            "cw",
            "ccw"
          ],
          "title": "Direction",
          "type": "string"
        },
        "facts": {
          "additionalProperties": {
            "$ref": "#/$defs/Fact"
          },
          "maxProperties": 40,
          "title": "Facts",
          "type": "object"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "group",
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "material": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Material"
        },
        "pitch_mm": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pitch Mm"
        },
        "role": {
          "enum": [
            "stock",
            "coax",
            "pair",
            "ribbon",
            "figure-eight",
            "bundle"
          ],
          "title": "Role",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "stripe_colors": {
          "items": {
            "pattern": "^#[0-9a-fA-F]{6}$",
            "type": "string"
          },
          "maxItems": 8,
          "title": "Stripe Colors",
          "type": "array"
        },
        "x_mm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": 0,
          "title": "X Mm"
        },
        "y_mm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": 0,
          "title": "Y Mm"
        }
      },
      "required": [
        "id",
        "label",
        "kind",
        "role"
      ],
      "title": "GroupElement",
      "type": "object"
    },
    "Input": {
      "additionalProperties": false,
      "properties": {
        "constituent_local_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Constituent Local Id",
          "type": "string"
        },
        "field": {
          "title": "Field",
          "type": "string"
        }
      },
      "required": [
        "constituent_local_id",
        "field"
      ],
      "title": "Input",
      "type": "object"
    },
