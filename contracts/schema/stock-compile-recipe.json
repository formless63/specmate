          ],
          "default": null,
          "title": "Outer Diameter Mm"
        },
        "source": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "stripe_colors": {
          "items": {
            "pattern": "^#[0-9a-fA-F]{6}$",
            "type": "string"
          },
          "maxItems": 8,
          "title": "Stripe Colors",
          "type": "array"
        },
        "x_mm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
