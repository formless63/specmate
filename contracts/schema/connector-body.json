{
  "$defs": {
    "Contact": {
      "additionalProperties": false,
      "properties": {
        "contact_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Contact Id",
          "type": "string"
        },
        "label": {
          "default": "",
          "maxLength": 200,
          "title": "Label",
          "type": "string"
        },
        "number": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Number"
        },
        "physical_role": {
          "default": "contact",
          "enum": [
            "contact",
            "shell",
            "key"
          ],
          "title": "Physical Role",
          "type": "string"
        },
        "position_mm": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Position Mm"
        }
      },
      "required": [
        "contact_id"
      ],
      "title": "Contact",
      "type": "object"
    },
    "ContactPair": {
      "additionalProperties": false,
      "properties": {
        "other": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Other",
          "type": "string"
        },
        "this": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "This",
          "type": "string"
        }
      },
      "required": [
        "this",
        "other"
      ],
      "title": "ContactPair",
      "type": "object"
    },
    "MatesWith": {
      "additionalProperties": false,
      "description": "A declared mating partner. Mating is never inferred from family names or labels.",
      "properties": {
        "basis": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Basis"
        },
        "body_revision_id": {
          "format": "uuid",
          "title": "Body Revision Id",
          "type": "string"
        },
        "correspondence": {
          "default": "same_contact_id",
          "enum": [
            "same_contact_id",
            "explicit"
          ],
          "title": "Correspondence",
          "type": "string"
        },
        "pairs": {
          "items": {
            "$ref": "#/$defs/ContactPair"
          },
          "maxItems": 1000,
          "title": "Pairs",
          "type": "array"
        },
        "review": {
          "default": "unreviewed",
          "enum": [
            "unreviewed",
            "reviewed"
          ],
          "title": "Review",
          "type": "string"
        }
      },
      "required": [
        "body_revision_id"
      ],
      "title": "MatesWith",
      "type": "object"
    },
    "Orientation": {
      "additionalProperties": false,
      "properties": {
        "datum": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Datum"
        },
        "rotation_degrees": {
          "anyOf": [
            {
              "exclusiveMaximum": 360,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rotation Degrees"
        },
        "viewing_side": {
          "default": "unknown",
          "enum": [
            "mating",
            "termination",
            "unknown"
          ],
          "title": "Viewing Side",
          "type": "string"
        }
      },
      "title": "Orientation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contacts": {
      "items": {
        "$ref": "#/$defs/Contact"
      },
      "maxItems": 1000,
      "title": "Contacts",
      "type": "array"
    },
    "drawing_orientation": {
      "$ref": "#/$defs/Orientation"
    },
    "family": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Family"
    },
    "kind": {
      "const": "connector_body",
      "default": "connector_body",
      "title": "Kind",
      "type": "string"
    },
    "mates_with": {
      "items": {
        "$ref": "#/$defs/MatesWith"
      },
      "maxItems": 50,
      "title": "Mates With",
      "type": "array"
    },
    "mating_role": {
      "default": "unknown",
      "enum": [
        "plug",
        "receptacle",
        "hermaphroditic",
        "unknown"
      ],
      "title": "Mating Role",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "title": "ConnectorBody",
  "type": "object"
}
