{
  "additionalProperties": false,
  "description": "One family of workspace collection records, newest first.\n\nWith ``project_id`` (navigation context) the items that project references come\nfirst; ``referenced_only`` limits the list to them. Context never changes access.",
  "properties": {
    "after": {
      "anyOf": [
        {
          "maxLength": 300,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "After"
    },
    "family": {
      "default": "definition",
      "enum": [
        "definition",
        "source_bundle",
        "physical_unit",
        "stock_account",
        "fact_subject"
      ],
      "title": "Family",
      "type": "string"
    },
    "kinds": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Kinds",
      "type": "array"
    },
    "limit": {
      "default": 50,
      "maximum": 100,
      "minimum": 1,
      "title": "Limit",
      "type": "integer"
    },
    "project_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Id"
    },
    "query": {
      "default": "",
      "maxLength": 200,
      "title": "Query",
      "type": "string"
    },
    "referenced_only": {
      "default": false,
      "title": "Referenced Only",
      "type": "boolean"
    },
    "workspace_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Workspace Id"
    }
  },
  "title": "ListLibrary",
  "type": "object"
}
