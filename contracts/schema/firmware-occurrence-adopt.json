{
  "additionalProperties": false,
  "properties": {
    "basis": {
      "maxLength": 2000,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Basis",
      "type": "string"
    },
    "draft_id": {
      "format": "uuid",
      "title": "Draft Id",
      "type": "string"
    },
    "firmware_revision_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Firmware Revision Id"
    },
    "path": {
      "items": {
        "pattern": "^[a-z][a-z0-9_-]{0,79}$",
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Path",
      "type": "array"
    },
    "review_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Review Sha256",
      "type": "string"
    }
  },
  "required": [
    "draft_id",
    "path",
    "firmware_revision_id",
    "review_sha256",
    "basis"
  ],
  "title": "AdoptOccurrence",
  "type": "object"
}
