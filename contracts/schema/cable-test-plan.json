{
  "$defs": {
    "DerivedFrom": {
      "additionalProperties": false,
      "description": "The cable intent row an expectation was proposed from; a record, never evidence.",
      "properties": {
        "intent_revision_id": {
          "format": "uuid",
          "title": "Intent Revision Id",
          "type": "string"
        },
        "row_ids": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Row Ids",
          "type": "array"
        }
      },
      "required": [
        "intent_revision_id",
        "row_ids"
      ],
      "title": "DerivedFrom",
      "type": "object"
    },
    "EvidenceInput": {
      "additionalProperties": false,
      "properties": {
        "citation": {
          "anyOf": [
            {
              "maxLength": 4000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Citation"
        },
        "source_bundle_revision_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Bundle Revision Id"
        },
        "source_path": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Path"
        },
        "status": {
          "default": "unknown",
          "enum": [
            "unknown",
            "unverified_citation",
            "registered_file"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "title": "EvidenceInput",
      "type": "object"
    },
    "Label": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Basis",
          "type": "string"
        },
        "endpoint_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endpoint Id"
        },
        "evidence": {
          "$ref": "#/$defs/EvidenceInput"
        },
        "local_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,79}$",
          "title": "Local Id",
          "type": "string"
        },
        "terminal": {
          "anyOf": [
            {
              "$ref": "#/$defs/Terminal"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "local_id",
        "text",
        "basis"
      ],
      "title": "Label",
      "type": "object"
    },
    "PairExpectation": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Basis",
          "type": "string"
        },
        "derived_from": {
          "anyOf": [
            {
              "$ref": "#/$defs/DerivedFrom"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence": {
          "$ref": "#/$defs/EvidenceInput"
        },
        "expected_resistance_ohm": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Resistance Ohm"
        },
        "first": {
          "$ref": "#/$defs/Terminal"
        },
        "intent": {
          "default": "unknown",
          "enum": [
            "continuity",
            "isolation",
            "unknown"
          ],
          "title": "Intent",
          "type": "string"
        },
        "local_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,79}$",
          "title": "Local Id",
          "type": "string"
        },
        "second": {
          "$ref": "#/$defs/Terminal"
        },
        "signal": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signal"
        }
      },
      "required": [
        "local_id",
        "first",
        "second",
        "basis"
      ],
      "title": "PairExpectation",
      "type": "object"
    },
    "Terminal": {
      "additionalProperties": false,
      "properties": {
        "contact_id": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "pattern": "^\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contact Id"
        },
        "element_path": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Element Path"
        },
        "endpoint_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,79}$",
          "title": "Endpoint Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "contact",
            "stock_feature"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "endpoint_id",
        "kind"
      ],
      "title": "Terminal",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cable_revision_id": {
      "format": "uuid",
      "title": "Cable Revision Id",
      "type": "string"
    },
    "labels": {
      "items": {
        "$ref": "#/$defs/Label"
      },
      "maxItems": 2048,
      "title": "Labels",
      "type": "array"
    },
    "occurrence_path": {
      "items": {
        "pattern": "^[a-z][a-z0-9_-]{0,79}$",
        "type": "string"
      },
      "maxItems": 32,
      "title": "Occurrence Path",
      "type": "array"
    },
    "pairs": {
      "items": {
        "$ref": "#/$defs/PairExpectation"
      },
      "maxItems": 2048,
      "title": "Pairs",
      "type": "array"
    },
    "root_revision_id": {
      "format": "uuid",
      "title": "Root Revision Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "root_revision_id",
    "cable_revision_id"
  ],
  "title": "TestPlan",
  "type": "object"
}
