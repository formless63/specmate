{
  "$defs": {
    "AttachmentRef": {
      "additionalProperties": false,
      "description": "An exact registered source file. Its bytes, hash and rights stay with the source.",
      "properties": {
        "bundle_revision_id": {
          "format": "uuid",
          "title": "Bundle Revision Id",
          "type": "string"
        },
        "label": {
          "default": "",
          "maxLength": 200,
          "title": "Label",
          "type": "string"
        },
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "bundle_revision_id",
        "path"
      ],
      "title": "AttachmentRef",
      "type": "object"
    },
    "Content": {
      "additionalProperties": false,
      "properties": {
        "attachments": {
          "items": {
            "$ref": "#/$defs/AttachmentRef"
          },
          "maxItems": 20,
          "title": "Attachments",
          "type": "array"
        },
        "body": {
          "default": "",
          "maxLength": 20000,
          "title": "Body",
          "type": "string"
        },
        "decision_status": {
          "anyOf": [
            {
              "enum": [
                "proposed",
                "accepted",
                "rejected",
                "superseded"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision Status"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "title": "Content",
      "type": "object"
    },
    "DefinitionTarget": {
      "additionalProperties": false,
      "properties": {
        "definition_id": {
          "format": "uuid",
          "title": "Definition Id",
          "type": "string"
        },
        "feature_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Feature Id"
        },
        "kind": {
          "const": "definition",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "definition_id"
      ],
      "title": "DefinitionTarget",
      "type": "object"
    },
    "OccurrenceTarget": {
      "additionalProperties": false,
      "properties": {
        "feature_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Feature Id"
        },
        "kind": {
          "const": "occurrence",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "items": {
            "pattern": "^[a-z][a-z0-9_-]{0,79}$",
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Path",
          "type": "array"
        },
        "snapshot_id": {
          "format": "uuid",
          "title": "Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "snapshot_id",
        "path"
      ],
      "title": "OccurrenceTarget",
      "type": "object"
    },
    "PhysicalUnitTarget": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "physical_unit",
          "title": "Kind",
          "type": "string"
        },
        "unit_id": {
          "format": "uuid",
          "title": "Unit Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "unit_id"
      ],
      "title": "PhysicalUnitTarget",
      "type": "object"
    },
    "ProjectTarget": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "project",
          "title": "Kind",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "project_id"
      ],
      "title": "ProjectTarget",
      "type": "object"
    },
    "RevisionTarget": {
      "additionalProperties": false,
      "properties": {
        "feature_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Feature Id"
        },
        "kind": {
          "const": "revision",
          "title": "Kind",
          "type": "string"
        },
        "revision_id": {
          "format": "uuid",
          "title": "Revision Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "revision_id"
      ],
      "title": "RevisionTarget",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "content": {
      "$ref": "#/$defs/Content"
    },
    "kind": {
      "enum": [
        "note",
        "decision",
        "attachment"
      ],
      "title": "Kind",
      "type": "string"
    },
    "links": {
      "items": {
        "discriminator": {
          "mapping": {
            "definition": "#/$defs/DefinitionTarget",
            "occurrence": "#/$defs/OccurrenceTarget",
            "physical_unit": "#/$defs/PhysicalUnitTarget",
            "project": "#/$defs/ProjectTarget",
            "revision": "#/$defs/RevisionTarget"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/ProjectTarget"
          },
          {
            "$ref": "#/$defs/DefinitionTarget"
          },
          {
            "$ref": "#/$defs/RevisionTarget"
          },
          {
            "$ref": "#/$defs/OccurrenceTarget"
          },
          {
            "$ref": "#/$defs/PhysicalUnitTarget"
          }
        ]
      },
      "maxItems": 50,
      "title": "Links",
      "type": "array"
    },
    "project_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Id"
    },
    "workspace_id": {
      "format": "uuid",
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "kind",
    "content"
  ],
  "title": "CreateItem",
  "type": "object"
}
