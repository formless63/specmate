{
  "$defs": {
    "PcbBuildRef": {
      "additionalProperties": false,
      "properties": {
        "build_id": {
          "format": "uuid",
          "title": "Build Id",
          "type": "string"
        },
        "intake_id": {
          "format": "uuid",
          "title": "Intake Id",
          "type": "string"
        }
      },
      "required": [
        "intake_id",
        "build_id"
      ],
      "title": "PcbBuildRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "bom_plan_revision_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bom Plan Revision Id"
    },
    "bom_purpose": {
      "default": "procurement",
      "enum": [
        "assembly_contents",
        "procurement",
        "pcb_fabrication",
        "pcb_population",
        "consumables"
      ],
      "title": "Bom Purpose",
      "type": "string"
    },
    "pcb_fabrication_builds": {
      "items": {
        "$ref": "#/$defs/PcbBuildRef"
      },
      "maxItems": 64,
      "title": "Pcb Fabrication Builds",
      "type": "array"
    },
    "preparation_document_set_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "maxItems": 64,
      "title": "Preparation Document Set Ids",
      "type": "array"
    },
    "purpose": {
      "const": "authorized_review",
      "default": "authorized_review",
      "title": "Purpose",
      "type": "string"
    },
    "quantity": {
      "anyOf": [
        {
          "maximum": 1000000,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quantity"
    },
    "reviewed_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Reviewed Sha256",
      "type": "string"
    },
    "rights_acknowledged": {
      "default": false,
      "title": "Rights Acknowledged",
      "type": "boolean"
    },
    "root_revision_id": {
      "format": "uuid",
      "title": "Root Revision Id",
      "type": "string"
    },
    "scene_drawing_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "maxItems": 64,
      "title": "Scene Drawing Ids",
      "type": "array"
    },
    "test_plan_revision_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "maxItems": 256,
      "title": "Test Plan Revision Ids",
      "type": "array"
    }
  },
  "required": [
    "root_revision_id",
    "reviewed_sha256"
  ],
  "title": "Download",
  "type": "object"
}
