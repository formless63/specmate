          "title": "Origin",
          "type": "string"
        },
        "references": {
          "items": {
            "type": "string"
          },
          "title": "References",
          "type": "array"
        }
      },
      "required": [
        "origin"
      ],
      "title": "Basis",
      "type": "object"
    },
    "EvidenceItem": {
