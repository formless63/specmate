# Generate random required secrets once with python3 deploy/configure.py --output .env.
# If Compose is copied to an operator stack folder, set this to the public checkout path.
SPECMATE_SOURCE_DIR=.
SPECMATE_SECRET_KEY=
POSTGRES_PASSWORD=
SPECMATE_DB_PASSWORD=
TEMPORAL_DB_PASSWORD=
TEMPORAL_VISIBILITY_DB_PASSWORD=

SPECMATE_BIND_IP=127.0.0.1
SPECMATE_PORT=8080
SPECMATE_OPERATOR_BIND_IP=127.0.0.1
SPECMATE_TEMPORAL_UI_PORT=8081
SPECMATE_ALLOWED_HOSTS=localhost,127.0.0.1,app
SPECMATE_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Set true for HTTPS. False is intended only for the loopback HTTP example.
SPECMATE_SECURE_COOKIES=false

# Optional runner profile. configure.py supplies an absolute sibling state directory.
SPECMATE_RUNNER_HOST_STATE_DIR=
SPECMATE_DOCKER_SOCKET=/var/run/docker.sock
